{
  "host": "web.snapchat.com",
  "suite": "write",
  "description": "Write smoke for send_message (text, image + text, not found). Run ONCE, sequentially. Test account + self-chat preferred. See docs/BAN_RISKS.md.",
  "cases": [
    {
      "id": "write-send-text-self",
      "script": "send_message",
      "args": { "name": "saffist3r", "text": "Reduck send_message test (text only)" },
      "tag": "write",
      "expect": {
        "ok": true,
        "clicked": true,
        "delivered": true,
        "opened": true,
        "notFound": false
      }
    },
    {
      "id": "write-send-image-text-self",
      "script": "send_message",
      "args": { "name": "saffist3r", "text": "Reduck send_message test (image + text)" },
      "files": { "image.png": "tests/fixtures/send-test.png" },
      "tag": "write",
      "expect": {
        "ok": true,
        "clicked": true,
        "delivered": true,
        "opened": true,
        "notFound": false
      }
    },
    {
      "id": "write-send-not-found",
      "script": "send_message",
      "args": { "name": "zzz-nonexistent-chat-xyz", "text": "should not send" },
      "tag": "write",
      "expect": {
        "opened": false,
        "notFound": true,
        "delivered": false,
        "hasAvailable": true
      }
    }
  ]
}
