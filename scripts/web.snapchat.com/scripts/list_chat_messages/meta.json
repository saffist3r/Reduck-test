{
  "host": "web.snapchat.com",
  "slug": "list_chat_messages",
  "name": "List chat messages",
  "description": "Optionally open a chat by name, then return the latest visible text messages with a best-effort sender. Pass since (e.g. your announcement text) to get only the replies after it. Read-only, never sends.",
  "visibility": "public",
  "loggedIn": true,
  "sideEffects": "none",
  "humanRequired": false,
  "input": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Optional chat display name to open first (from list_chats). Exact name wins; several partial matches return ambiguous."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 20,
        "description": "Max messages to return, newest last (default 20)."
      },
      "since": {
        "type": "string",
        "description": "Optional text of an earlier message (e.g. the announcement). Only messages after its last occurrence are returned."
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["count", "messages", "url"],
    "properties": {
      "opened": { "type": "boolean" },
      "notFound": { "type": "boolean" },
      "ambiguous": { "type": "boolean" },
      "candidates": { "type": "array", "items": { "type": "string" } },
      "name": { "type": ["string", "null"] },
      "count": { "type": "integer" },
      "messages": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "from": { "type": ["string", "null"] },
            "when": { "type": ["string", "null"] },
            "type": { "type": "string" }
          }
        }
      },
      "since": { "type": "string" },
      "sinceFound": { "type": "boolean" },
      "composerHint": { "type": "boolean" },
      "tooManyTabs": { "type": "boolean" },
      "note": { "type": ["string", "null"] },
      "url": { "type": "string" }
    }
  }
}
