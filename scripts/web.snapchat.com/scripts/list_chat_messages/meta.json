{
  "host": "web.snapchat.com",
  "slug": "list_chat_messages",
  "name": "List chat messages",
  "description": "Optionally open a chat by name, then scrape visible text message bubbles (read-only, never sends). Empty visible history returns count 0 with a note — no timeout.",
  "visibility": "public",
  "loggedIn": true,
  "sideEffects": "none",
  "humanRequired": false,
  "input": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Optional chat display name to open first (from list_chats)."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 20,
        "description": "Max messages to return (default 20)."
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["count", "messages", "url"],
    "properties": {
      "opened": { "type": "boolean" },
      "notFound": { "type": "boolean" },
      "name": { "type": ["string", "null"] },
      "count": { "type": "integer" },
      "messages": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "from": { "type": ["string", "null"] },
            "when": { "type": ["string", "null"] },
            "type": { "type": "string" }
          }
        }
      },
      "composerHint": { "type": "boolean" },
      "tooManyTabs": { "type": "boolean" },
      "note": { "type": ["string", "null"] },
      "url": { "type": "string" }
    }
  }
}
