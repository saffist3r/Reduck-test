{
  "host": "anybuddyapp.com",
  "slug": "search_clubs",
  "name": "Search clubs",
  "description": "Search bookable clubs near a city for a racket sport. Returns one page of clubs with ratings, address, coords, and visible time slots/prices for an optional date (YYYY-MM-DD). location_slug comes from search_locations (e.g. paris-75000-fr).",
  "visibility": "private",
  "loggedIn": false,
  "sideEffects": "none",
  "humanRequired": false,
  "input": {
    "type": "object",
    "required": ["location_slug"],
    "properties": {
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Optional availability date as YYYY-MM-DD. Omit for Anybuddy's default (today)."
      },
      "page": {
        "type": "integer",
        "default": 1,
        "minimum": 1,
        "description": "1-based results page (site shows ~12 clubs/page)."
      },
      "sport": {
        "enum": ["tennis", "padel", "badminton", "squash", "pickleball", "table-tennis"],
        "type": "string",
        "default": "tennis",
        "description": "Sport path segment: tennis | padel | badminton | squash | pickleball | table-tennis."
      },
      "location_slug": {
        "type": "string",
        "minLength": 1,
        "description": "City slug from search_locations, e.g. lyon-69000-fr or paris-75000-fr."
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["sport", "location_slug", "page", "totalPages", "count", "clubs", "url"],
    "properties": {
      "url": { "type": "string" },
      "date": { "type": ["string", "null"] },
      "page": { "type": "integer" },
      "clubs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["slug", "slots"],
          "properties": {
            "lat": { "type": ["number", "null"] },
            "lon": { "type": ["number", "null"] },
            "url": { "type": ["string", "null"] },
            "city": { "type": ["string", "null"] },
            "name": { "type": ["string", "null"] },
            "slug": { "type": "string" },
            "image": { "type": ["string", "null"] },
            "slots": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["time", "priceEur", "durationMin"],
                "properties": {
                  "time": { "type": "string" },
                  "priceEur": { "type": "number" },
                  "durationMin": { "type": "number" }
                }
              }
            },
            "rating": { "type": ["number", "null"] },
            "address": { "type": ["string", "null"] },
            "country": { "type": ["string", "null"] },
            "distanceKm": { "type": ["number", "null"] },
            "reviewCount": { "type": ["number", "null"] },
            "fromPriceEur": { "type": ["number", "null"] }
          }
        }
      },
      "count": { "type": "integer" },
      "sport": { "type": "string" },
      "totalClubs": { "type": ["integer", "null"] },
      "totalPages": { "type": "integer" },
      "location_slug": { "type": "string" }
    }
  }
}
